# REFERENCE ONLY: this static HTML/JavaScript frontend does not load .env files.
# Copying this file to .env will NOT change frontend behavior.
# Current configuration lives in FE/js/common/config.js.
# These are reference values, not environment variables consumed by the app.
API_BASE_URL=http://127.0.0.1:5000/api/v1
SOCKET_URL=http://127.0.0.1:5000

# Local/file pages use DEFAULT_LOCAL_ORIGIN in config.js. Other origins use
# the current page origin; /api/v1, /uploads and sockets must reach the backend.
# To change local backend host/port, edit DEFAULT_LOCAL_ORIGIN in config.js.
# Admin analytics.html, orders.html, dashboard.html and users.html also contain
# hardcoded API URLs that must be updated separately.
# Serve the repository root, e.g. open:
# http://127.0.0.1:5500/FE/pages/customer/index.html
# Set BE CLIENT_URL to the exact frontend origin (without /FE or a page path).
# Never put database credentials, JWT secrets or payment secrets in the FE.
